# systemd-Dienst für das Dashboard auf einem Linux-Server.
# Kopieren nach /etc/systemd/system/triathlon-dashboard.service, Pfade/Benutzer anpassen, dann:
#   sudo systemctl daemon-reload && sudo systemctl enable --now triathlon-dashboard
[Unit]
Description=Triathlon Dashboard (Streamlit)
After=network-online.target
Wants=network-online.target

[Service]
User=tri
WorkingDirectory=/opt/triathlon-dashboard
# Nutzerdaten außerhalb des Programmordners – so überlebt ein neues git pull alles
Environment=TRI_DATA_DIR=/var/lib/triathlon-dashboard
ExecStart=/opt/triathlon-dashboard/.venv/bin/streamlit run app.py \
    --server.address 127.0.0.1 --server.port 8501 \
    --server.headless true --browser.gatherUsageStats false
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
